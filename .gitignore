# Secrets live outside the repo (ADR 0015); this is a second net.
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Per-machine Claude Code state.
.claude/worktrees/
.claude/settings.local.json

# Editors and OS.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Tooling output.
node_modules/
dist/
# Written by `tsc -b`; `npm run typecheck` (tsc --noEmit) never writes it.
*.tsbuildinfo
__pycache__/
.venv/
.vagrant/
.ansible/
.pytest_cache/
.ruff_cache/
.hypothesis/

# Terraform: providers are downloaded per checkout; state lives on the dev VM
# (ADR 0029), never in the repo. .terraform.lock.hcl is committed.
.terraform/
*.tfstate
*.tfstate.*
