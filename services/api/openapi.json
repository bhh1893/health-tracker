{
  "components": {
    "schemas": {
      "CatalogRef": {
        "description": "How any response points at a Catalog item (ADR 0006).",
        "properties": {
          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "archived"
        ],
        "title": "CatalogRef",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Food": {
        "properties": {
          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Quantity"
          },
          "last_unit": {
            "anyOf": [
              {
                "enum": [
                  "g",
                  "count"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Unit"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "archived"
        ],
        "title": "Food",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthStatus",
        "type": "object"
      },
      "PatchItem": {
        "additionalProperties": false,
        "properties": {
          "allow_similar": {
            "default": false,
            "title": "Allow Similar",
            "type": "boolean"
          },
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "PatchItem",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "existing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "similar": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CatalogRef"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similar"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PutItem": {
        "additionalProperties": false,
        "properties": {
          "allow_similar": {
            "default": false,
            "title": "Allow Similar",
            "type": "boolean"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "PutItem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Health Tracker API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/exercises": {
      "get": {
        "description": "Suggest Exercise items: matches for q, or the most recently used when q is empty.",
        "operationId": "suggest_exercises",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 200,
              "pattern": "^[^\\x00]*$",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Archived",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CatalogRef"
                  },
                  "title": "Response Suggest Exercises",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Suggest",
        "tags": [
          "exercises"
        ]
      }
    },
