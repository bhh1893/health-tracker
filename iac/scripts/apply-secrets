#!/usr/bin/env bash
# Copies every secret from ~/.config/health-tracker/ into the cluster (ADR 0015).
# Run on the dev VM. Safe to re-run: unchanged Secrets are reported as `unchanged`.
# The Ansible platform role runs it before applying the edge Gateway, and
# restore-data runs it again first thing.
#
# kubectl reads values from files and hands them on through a pipe, so they never
# appear in a command line, which any user on the machine can read with `ps`.
# Do not add `set -x` or print the rendered YAML: base64 is not encryption.
set -euo pipefail

secrets_dir="$HOME/.config/health-tracker"
app_namespace=health-tracker
argocd_namespace=argocd
cert_manager_namespace=cert-manager
edge_namespace=edge
repo_url=git@github.com:bhh1893/health-tracker.git

# Most are generated by iac/ansible/dev.yml; cloudflare-dns01-token and
# google-client-secret are made by hand in a web console and entered with
# enter-secret. docs/runbooks/secrets.md says where each one comes from.
for file in api-token db-owner.env db-api.env backup.env argocd-deploy-key \
  cloudflare-dns01-token google-client-secret auth-cookie-secret; do
  if [[ ! -s "$secrets_dir/$file" ]]; then
    echo "apply-secrets: $secrets_dir/$file is missing or empty; see docs/runbooks/secrets.md" >&2
    exit 1
  fi
done

ensure_namespace() {
  kubectl get namespace "$1" >/dev/null 2>&1 || kubectl create namespace "$1"
}

# CNPG reads `username` and `password`; the reload label makes it apply a changed
# password straight away. `DATABASE_URL` rides along for `api` and the migration Job.
apply_db_secret() {
  kubectl create secret generic "$1" \
    --namespace "$app_namespace" \
    --type=kubernetes.io/basic-auth \
    --from-env-file="$secrets_dir/$1.env" \
    --dry-run=client -o yaml |
    kubectl label --local -f - cnpg.io/reload=true -o yaml |
    kubectl apply -f -
}

ensure_namespace "$app_namespace"
ensure_namespace "$argocd_namespace"
ensure_namespace "$cert_manager_namespace"
ensure_namespace "$edge_namespace"

kubectl create secret generic api-token \
  --namespace "$app_namespace" \
  --from-file=token="$secrets_dir/api-token" \
  --dry-run=client -o yaml |
  kubectl apply -f -

# One Secret for both oauth2-proxy sidecars, `api` and `web`: each needs both values
# (ADR 0015, ADR 0021). The client ID is not here; it is public and lives in git.
kubectl create secret generic auth-proxy \
  --namespace "$app_namespace" \
  --from-file=client-secret="$secrets_dir/google-client-secret" \
  --from-file=cookie-secret="$secrets_dir/auth-cookie-secret" \
  --dry-run=client -o yaml |
  kubectl apply -f -

apply_db_secret db-owner
apply_db_secret db-api

kubectl create secret generic backup-key \
  --namespace "$app_namespace" \
  --from-env-file="$secrets_dir/backup.env" \
  --dry-run=client -o yaml |
  kubectl apply -f -

# Argo CD finds repository credentials by this label, whatever the Secret's name.
kubectl create secret generic repo-health-tracker \
  --namespace "$argocd_namespace" \
  --from-literal=type=git \
  --from-literal=url="$repo_url" \
  --from-file=sshPrivateKey="$secrets_dir/argocd-deploy-key" \
  --dry-run=client -o yaml |
  kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml |
  kubectl apply -f -

# Read by both Let's Encrypt ClusterIssuers to write the DNS-01 TXT record. A
# ClusterIssuer looks for Secrets in cert-manager's own namespace (ADR 0025).
kubectl create secret generic cloudflare-dns01-token \
  --namespace "$cert_manager_namespace" \
  --from-file=api-token="$secrets_dir/cloudflare-dns01-token" \
  --dry-run=client -o yaml |
  kubectl apply -f -

# The Gateway's certificate, saved by save-tls. Restored before the Gateway exists,
# so cert-manager finds a valid certificate and issues nothing (ADR 0025). Created
# only if missing, never replaced: after cert-manager renews it, the cluster's copy
# is newer than the saved one, and overwriting would roll the certificate back.
tls_file="$secrets_dir/health-tls.json"
if kubectl get secret health-tls --namespace "$edge_namespace" >/dev/null 2>&1; then
  echo "secret/health-tls unchanged"
elif [[ -s "$tls_file" ]]; then
  kubectl create -f "$tls_file"
else
  echo "apply-secrets: no saved certificate in $tls_file; cert-manager will issue a new one, then run iac/scripts/save-tls" >&2
fi
