#!/usr/bin/env bash
# Copies every secret from ~/.config/health-tracker/ into the cluster (ADR 0015).
# Run on the dev VM. Safe to re-run: unchanged Secrets are reported as `unchanged`.
#
# kubectl reads values from files and hands them on through a pipe, so they never
# appear in a command line, which any user on the machine can read with `ps`.
# Do not add `set -x` or print the rendered YAML: base64 is not encryption.
set -euo pipefail

secrets_dir="$HOME/.config/health-tracker"
app_namespace=health-tracker
argocd_namespace=argocd
repo_url=git@github.com:bhh1893/health-tracker.git

for file in api-token db-owner.env db-api.env backup.env argocd-deploy-key; do
  if [[ ! -s "$secrets_dir/$file" ]]; then
    echo "apply-secrets: $secrets_dir/$file is missing or empty; run iac/ansible/dev.yml" >&2
    exit 1
  fi
done

ensure_namespace() {
  kubectl get namespace "$1" >/dev/null 2>&1 || kubectl create namespace "$1"
}

# CNPG reads `username` and `password`; the reload label makes it apply a changed
# password straight away. `DATABASE_URL` rides along for `api` and the migration Job.
apply_db_secret() {
  kubectl create secret generic "$1" \
    --namespace "$app_namespace" \
    --type=kubernetes.io/basic-auth \
    --from-env-file="$secrets_dir/$1.env" \
    --dry-run=client -o yaml |
    kubectl label --local -f - cnpg.io/reload=true -o yaml |
    kubectl apply -f -
}

ensure_namespace "$app_namespace"
ensure_namespace "$argocd_namespace"

kubectl create secret generic api-token \
  --namespace "$app_namespace" \
  --from-file=token="$secrets_dir/api-token" \
  --dry-run=client -o yaml |
  kubectl apply -f -

apply_db_secret db-owner
apply_db_secret db-api

kubectl create secret generic backup-key \
  --namespace "$app_namespace" \
  --from-env-file="$secrets_dir/backup.env" \
  --dry-run=client -o yaml |
  kubectl apply -f -

# Argo CD finds repository credentials by this label, whatever the Secret's name.
kubectl create secret generic repo-health-tracker \
  --namespace "$argocd_namespace" \
  --from-literal=type=git \
  --from-literal=url="$repo_url" \
  --from-file=sshPrivateKey="$secrets_dir/argocd-deploy-key" \
  --dry-run=client -o yaml |
  kubectl label --local -f - argocd.argoproj.io/secret-type=repository -o yaml |
  kubectl apply -f -
