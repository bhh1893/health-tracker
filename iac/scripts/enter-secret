#!/usr/bin/env bash
# Reads a secret made in a web console (Cloudflare, Google) at a hidden prompt and
# writes it to ~/.config/health-tracker/<name> (ADR 0015). Run it yourself in a
# terminal, never through Claude: the value must not pass through a chat.
#
#   enter-secret cloudflare-dns01-token
#
# Replaces the file if it exists, which is also how you rotate. Then run
# apply-secrets. A script rather than a one-liner, because `read -p` means
# something else in zsh.
set -euo pipefail

secrets_dir="$HOME/.config/health-tracker"

if [[ $# -ne 1 || ! "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "usage: enter-secret <name>   (lowercase letters, digits and dashes)" >&2
  exit 2
fi
name=$1

# Output captured by a pipe or by Claude is not a terminal.
if [[ ! -t 0 ]]; then
  echo "enter-secret: run this yourself in a terminal" >&2
  exit 1
fi

# -s hides what you type or paste; -r keeps backslashes as they are.
read -rsp "Paste $name, then Enter: " value
echo
if [[ -z "$value" ]]; then
  echo "enter-secret: nothing entered, $name left as it was" >&2
  exit 1
fi

# umask 077 makes the file 600 from the moment it exists. Write a temp file and
# move it, so a killed run cannot leave half a value behind.
umask 077
mkdir -p "$secrets_dir"
printf '%s' "$value" >"$secrets_dir/$name.tmp"
mv "$secrets_dir/$name.tmp" "$secrets_dir/$name"
unset value

echo "Wrote $secrets_dir/$name. Next: iac/scripts/apply-secrets"
