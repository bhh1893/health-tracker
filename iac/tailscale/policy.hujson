// Tailnet policy: who may reach what on the tailnet (ADR 0020).
//
// This file is the source of truth. CI tests it on a pull request and applies it on
// merge to main (.github/workflows/ci.yml). The admin console editor is locked, so a
// change made there would be overwritten by the next apply anyway.
//
// A tailnet with a policy denies by default: only what a grant below allows gets through.
// The repo is public (ADR 0017), so this file names roles and tags, never a person's email.
{
	// A tag is an identity for a machine, in place of a person's. Each line says who may
	// give a device that tag.
	"tagOwners": {
		// The Tailscale Kubernetes Operator. Its OAuth client is created with this tag
		// by the owner in the admin console.
		"tag:k8s-operator": ["autogroup:owner"],
		// The proxy pods the operator creates. Only the operator may hand this tag out,
		// so no person can make a device that poses as part of the cluster.
		"tag:k8s": ["tag:k8s-operator"],
	},

	// A device does not get to serve a Tailscale Service just by announcing it; someone has
	// to approve it. This approves ahead of time: a device tagged tag:k8s may host a Service
	// tagged tag:k8s, which is what the operator creates. Without it, every rebuild would
	// wait for a click in the admin console.
	"autoApprovers": {
		"services": {
			"tag:k8s": ["tag:k8s"],
		},
	},

	"grants": [
		// The owner's own devices reach everything, on every port. Keeps today's access
		// for administration: for example, reaching a proxy pod directly to debug it.
		{
			"src": ["autogroup:owner"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Every person on the tailnet reaches the app and nothing else: HTTPS on 443, and
		// 80 only so the Gateway can redirect to HTTPS. They cannot reach each other's
		// devices or any other port on the cluster's proxies.
		{
			"src": ["autogroup:member"],
			"dst": ["svc:health"],
			"ip":  ["tcp:443", "tcp:80"],
		},
		// No grant has a tag as src, so cluster devices cannot start a connection to
		// anything on the tailnet. A compromised proxy pod has nowhere to go.
	],

	// Checked on every test and apply; a failing test rejects the policy. This one pins
	// the rule in the last comment above, so a later grant cannot quietly undo it.
	"tests": [
		{
			"src":  "tag:k8s",
			"deny": ["tag:k8s-operator:443", "tag:k8s-operator:22"],
		},
	],
}
